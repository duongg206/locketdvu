<?xml version='1.0' encoding='utf-8'?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>PayloadDisplayName</key>
    <string>Locket Gold 💛 Anti-Revoke Safe</string>

    <key>PayloadDescription</key>
    <string>Cấu hình Split-DNS chỉ chặn thu hồi Locket Gold. 100% an toàn cho App Ngân Hàng, TikTok Shop và VNeID.&#10;@YangDvu</string>

    <key>PayloadIdentifier</key>
    <string>com.yangdvu.locket.dns</string>

    <key>PayloadScope</key>
    <string>System</string>

    <key>PayloadType</key>
    <string>Configuration</string>

    <key>PayloadUUID</key>
    <string>A1E2F262-DB73-40F6-BD22-2E42A43A3C94</string>

    <key>PayloadVersion</key>
    <integer>1</integer>

    <key>PayloadContent</key>
    <array>
      <dict>
        <key>DNSSettings</key>
        <dict>
          <key>DNSProtocol</key>
          <string>HTTPS</string>
          <key>ServerAddresses</key>
          <array>
            <string>1.1.1.1</string>
            <string>1.0.0.1</string>
          </array>
          <key>ServerURL</key>
          <string>https://api.p12.vn/dns-query</string>
          
          <!-- SPLIT-DNS: CHỈ ÁP DỤNG DUY NHẤT CHO LOCKET REVENUECAT -->
          <!-- Toàn bộ ngân hàng, mua sắm TikTok, Shopee dùng DNS gốc bình thường -->
          <key>SupplementalMatchDomains</key>
          <array>
            <string>api.revenuecat.com</string>
            <string>app.revenuecat.com</string>
            <string>revenuecat.com</string>
            <string>www.revenuecat.com</string>
            <string>api2.amplitude.com</string>
            <string>firebaselogging-pa.googleapis.com</string>
          </array>
        </dict>

        <key>OnDemandRules</key>
        <array>
          <dict>
            <key>Action</key>
            <string>EvaluateConnection</string>
            <key>ActionParameters</key>
            <array>
              <dict>
                <key>DomainAction</key>
                <string>NeverConnect</string>
                <key>Domains</key>
                <array>
                  <string>captive.apple.com</string>
                </array>
              </dict>
            </array>
          </dict>
          <dict>
            <key>Action</key>
            <string>Connect</string>
          </dict>
        </array>

        <key>PayloadType</key>
        <string>com.apple.dnsSettings.managed</string>
        <key>PayloadIdentifier</key>
        <string>com.yangdvu.locket.dns.managed</string>
        <key>PayloadUUID</key>
        <string>B2E3F4G5-EC84-51G7-CE33-3F53B54B4D05</string>
        <key>PayloadDisplayName</key>
        <string>Locket Gold Safe DNS</string>
        <key>PayloadOrganization</key>
        <string>YangDvu</string>
        <key>PayloadVersion</key>
        <integer>1</integer>
      </dict>
    </array>

    <key>PayloadOrganization</key>
    <string>YangDvu</string>
  </dict>
</plist>
